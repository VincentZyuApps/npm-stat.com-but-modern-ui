{
  "name": "npm-stat-modern-ui",
  "version": "0.2.0-beta.5+20260916",
  "private": true,
  "description": "A modern Tampermonkey UI for npm-stat.com",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "verify:build": "node scripts/verify/build.mjs",
    "verify:loading": "node scripts/verify/loading.mjs",
    "docs:screenshots": "node scripts/docs/screenshots.mjs",
    "docs:setup": "node scripts/docs/setup.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:build && node --check dist/npm-stat-modern-ui.user.js"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-monkey": "^6.0.1"
  },
  "dependencies": {
    "echarts": "^6.1.0"
  }
}
